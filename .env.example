# Copy this file to .env.local and fill in what you need. Everything is optional.

# Public address of the live site. Used for canonical URLs, sitemap, Open Graph and structured data.
NEXT_PUBLIC_SITE_URL=https://darshandyechem.com

# Search engine ownership tags (paste only the token, not the whole <meta> tag).
# Google Search Console -> Settings -> Ownership verification -> HTML tag
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools -> Verify -> HTML meta tag
NEXT_PUBLIC_BING_SITE_VERIFICATION=
